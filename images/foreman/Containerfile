# Rootless Foreman on UBI 9 for Kubernetes/OpenShift

# foreman_bootdisk builds ISO images with syslinux, iPXE, xorriso, dosfstools, and mtools, which
# are in RHEL 9 but not in UBI 9. The signed CentOS Stream 9 packages are verified here and
# installed in the final stage, with their remaining dependencies from UBI. GRUB 2 and shim are
# needed only as EFI binaries for the EFI boot image, so only those files are copied.
FROM quay.io/centos/centos:stream9 AS bootdisk

RUN mkdir -p /rpms /efi \
    && dnf download -q --arch x86_64,noarch --destdir /rpms syslinux syslinux-nonlinux mtools \
        xorriso libisoburn libisofs libburn dosfstools ipxe-bootimgs-x86 \
    && rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial \
    && rpm -K /rpms/*.rpm \
    && dnf install -y --nodocs --setopt=install_weak_deps=0 grub2-efi-x64 shim-x64 \
    && cp /boot/efi/EFI/centos/grubx64.efi /boot/efi/EFI/centos/shimx64.efi /boot/efi/EFI/centos/mmx64.efi /efi/ \
    && chmod 0644 /efi/* \
    && dnf clean all

FROM registry.access.redhat.com/ubi9/ubi:9.8-1793861509

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# renovate: datasource=github-tags depName=theforeman/foreman
ARG FOREMAN_VERSION=5.0

# Exact RPM versions, tracked by Renovate from the repositories of FOREMAN_VERSION.
# A new FOREMAN_VERSION also needs the registry URLs below and every version updated.
# renovate: datasource=rpm depName=foreman registryUrl=https://yum.theforeman.org/releases/5.0/el9/x86_64/repodata/
ARG FOREMAN_RPM=5.0.1-2.el9
# renovate: datasource=rpm depName=rubygem-foreman-tasks registryUrl=https://yum.theforeman.org/plugins/5.0/el9/x86_64/repodata/
ARG FOREMAN_TASKS_RPM=13.2.4-1.fm5_0.el9
# renovate: datasource=rpm depName=rubygem-foreman_ansible registryUrl=https://yum.theforeman.org/plugins/5.0/el9/x86_64/repodata/
ARG FOREMAN_ANSIBLE_RPM=18.0.6-1.fm5_0.el9
# renovate: datasource=rpm depName=rubygem-foreman_bootdisk registryUrl=https://yum.theforeman.org/plugins/5.0/el9/x86_64/repodata/
ARG FOREMAN_BOOTDISK_RPM=24.1.0-1.fm5_0.el9
# renovate: datasource=rpm depName=rubygem-foreman_discovery registryUrl=https://yum.theforeman.org/plugins/5.0/el9/x86_64/repodata/
ARG FOREMAN_DISCOVERY_RPM=26.1.3-2.fm5_0.el9
# renovate: datasource=rpm depName=rubygem-foreman_puppet registryUrl=https://yum.theforeman.org/plugins/5.0/el9/x86_64/repodata/
ARG FOREMAN_PUPPET_RPM=11.2.1-1.fm5_0.el9
# renovate: datasource=rpm depName=rubygem-foreman_remote_execution registryUrl=https://yum.theforeman.org/plugins/5.0/el9/x86_64/repodata/
ARG FOREMAN_REMOTE_EXECUTION_RPM=17.2.3-1.fm5_0.el9
# renovate: datasource=rpm depName=rubygem-foreman_templates registryUrl=https://yum.theforeman.org/plugins/5.0/el9/x86_64/repodata/
ARG FOREMAN_TEMPLATES_RPM=11.0.4-1.fm5_0.el9
# renovate: datasource=rpm depName=rubygem-foreman_webhooks registryUrl=https://yum.theforeman.org/plugins/5.0/el9/x86_64/repodata/
ARG FOREMAN_WEBHOOKS_RPM=6.0.1-1.fm5_0.el9

LABEL org.opencontainers.image.title="foreman" \
      org.opencontainers.image.description="Rootless Foreman for Kubernetes/OpenShift (experimental, unofficial)" \
      org.opencontainers.image.source="https://github.com/slauger/foreman-operator" \
      org.opencontainers.image.licenses="GPL-3.0-only"

# A fixed UID keeps file ownership predictable. OpenShift replaces it at runtime.
RUN groupadd -r -g 1001 foreman \
    && useradd -r -u 1001 -g foreman -d /usr/share/foreman -s /sbin/nologin foreman

COPY --from=bootdisk /rpms /tmp/bootdisk
# The default "Grub2 directory" of foreman_bootdisk.
COPY --from=bootdisk /efi /var/lib/foreman/bootdisk

# The plugin catalog. Each plugin's bundler.d file loads it only if FOREMAN_ENABLED_PLUGINS
# lists it, and the operator always sets that variable, so installed plugins stay off until
# spec.plugins enables them. foreman_openscap needs packages UBI lacks.
# foreman_bootdisk requires grub2-efi-x64, whose GRUB tools are not needed for its EFI binaries,
# so it is installed without dependency checks after all its other dependencies; the build
# fails if rpm reports any other unsatisfied dependency.
RUN dnf install -y --nodocs "https://yum.theforeman.org/releases/${FOREMAN_VERSION}/el9/x86_64/foreman-release.rpm" \
    && dnf install -y --nodocs "foreman-${FOREMAN_RPM}" "foreman-postgresql-${FOREMAN_RPM}" \
        "foreman-redis-${FOREMAN_RPM}" "foreman-service-${FOREMAN_RPM}" "foreman-dynflow-sidekiq-${FOREMAN_RPM}" \
    && dnf install -y --nodocs --setopt=install_weak_deps=0 \
        "rubygem-foreman-tasks-${FOREMAN_TASKS_RPM}" "rubygem-foreman_ansible-${FOREMAN_ANSIBLE_RPM}" \
        "rubygem-foreman_discovery-${FOREMAN_DISCOVERY_RPM}" "rubygem-foreman_puppet-${FOREMAN_PUPPET_RPM}" \
        "rubygem-foreman_remote_execution-${FOREMAN_REMOTE_EXECUTION_RPM}" \
        "rubygem-foreman_templates-${FOREMAN_TEMPLATES_RPM}" "rubygem-foreman_webhooks-${FOREMAN_WEBHOOKS_RPM}" \
        /tmp/bootdisk/*.rpm \
    && dnf download -q --destdir /tmp/bootdisk "rubygem-foreman_bootdisk-${FOREMAN_BOOTDISK_RPM}" \
    && rpm -K --nosignature /tmp/bootdisk/rubygem-foreman_bootdisk-*.rpm \
    && rpm -i --nodeps --excludedocs /tmp/bootdisk/rubygem-foreman_bootdisk-*.rpm \
    && unsatisfied="$(rpm -V --nofiles --nodigest --noscripts rubygem-foreman_bootdisk | grep 'is needed by' | grep -v 'grub2-efi-x64' || true)" \
    && if [ -n "$unsatisfied" ]; then echo "$unsatisfied"; exit 1; fi \
    && rm -rf /tmp/bootdisk \
    && unguarded="$(grep -L FOREMAN_ENABLED_PLUGINS /usr/share/foreman/bundler.d/foreman*.rb || true)" \
    && if [ -n "$unguarded" ]; then echo "plugins load unconditionally: $unguarded"; exit 1; fi \
    && dnf clean all

# The RPM scriptlets generate secrets at install time. They must never ship in an image:
# ENCRYPTION_KEY and SECRET_KEY_BASE come from the environment instead.
RUN rm -f /usr/share/foreman/config/initializers/encryption_key.rb /etc/foreman/encryption_key.rb \
    && echo "Foreman::Application.config.secret_key_base = ENV.fetch('SECRET_KEY_BASE')" \
        > /usr/share/foreman/config/initializers/local_secret_token.rb \
    && chmod 0644 /usr/share/foreman/config/initializers/local_secret_token.rb

# OpenShift random-UID pattern: group root owns writable paths and mirrors user permissions.
RUN for d in /etc/foreman /var/lib/foreman /var/log/foreman /run/foreman /usr/share/foreman/tmp; do \
        mkdir -p "$d"; \
        chgrp -R 0 "$d"; \
        chmod -R g=u "$d"; \
    done

ENV HOME=/tmp \
    RAILS_ENV=production \
    RAILS_LOG_TO_STDOUT=true \
    RAILS_SERVE_STATIC_FILES=true \
    FOREMAN_BIND=0.0.0.0 \
    MALLOC_ARENA_MAX=2

WORKDIR /usr/share/foreman
USER 1001:0
EXPOSE 3000
CMD ["/usr/share/foreman/bin/rails", "server", "--environment", "production", "--pid", "/tmp/rails.pid"]
