{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "operator", "replicaCount", "serviceAccount"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "operator": {
      "type": "object",
      "properties": {
        "defaultImageTag": {"type": "string", "minLength": 1},
        "watchNamespace": {"type": "string"},
        "leaderElection": {"type": "boolean"},
        "logLevel": {"type": "string", "enum": ["debug", "info", "error"]},
        "metricsSecure": {"type": "boolean"}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 0},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "extraEnv": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
    "extraEnvSecret": {"type": "string"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array"},
    "priorityClassName": {"type": "string"},
    "resources": {"type": "object"},
    "updateStrategy": {"type": "object"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]},
        "maxUnavailable": {"type": ["integer", "string"]}
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "livenessProbe": {"type": "object"},
    "readinessProbe": {"type": "object"},
    "startupProbe": {"type": "object"},
    "extraVolumes": {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "extraContainers": {"type": "array"},
    "extraInitContainers": {"type": "array"}
  }
}
