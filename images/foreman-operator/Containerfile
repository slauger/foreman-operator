# foreman-operator on UBI 9 minimal
FROM docker.io/library/golang:1.27.3 AS builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/
ARG TARGETARCH
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" -o manager ./cmd

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8-1794186349

LABEL org.opencontainers.image.title="foreman-operator" \
      org.opencontainers.image.description="Experimental Kubernetes operator for Foreman (unofficial)" \
      org.opencontainers.image.source="https://github.com/slauger/foreman-operator" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY --from=builder /workspace/manager /manager

USER 1001:0

ENTRYPOINT ["/manager"]
